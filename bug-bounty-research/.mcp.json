{
  "mcpServers": {
    "whitehat-device": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/device/index.js"],
      "env": {
        "BB_RESEARCH_IDB_BIN": "${BB_RESEARCH_IDB_BIN:-idb}",
        "BB_RESEARCH_ADB_BIN": "${BB_RESEARCH_ADB_BIN:-adb}",
        "ANDROID_SERIAL": "${ANDROID_SERIAL:-}",
        "IDB_COMPANION": "${IDB_COMPANION:-}",
        "IDB_UDID": "${IDB_UDID:-}"
      }
    },
    "fbdl": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/fbdl/index.js"],
      "env": {
        "BB_RESEARCH_TOKEN": "${BB_RESEARCH_TOKEN:-}",
        "FBDL_API_TOKEN": "${FBDL_API_TOKEN:-}",
        "BB_RESEARCH_LOG_LEVEL": "${BB_RESEARCH_LOG_LEVEL:-warn}",
        "HTTPS_PROXY": "${HTTPS_PROXY:-}",
        "HTTP_PROXY": "${HTTP_PROXY:-}",
        "NO_PROXY": "${NO_PROXY:-}",
        "NODE_EXTRA_CA_CERTS": "${NODE_EXTRA_CA_CERTS:-}"
      }
    },
    "meta-context": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/meta-context/index.js"],
      "env": {
        "BB_RESEARCH_TOKEN": "${BB_RESEARCH_TOKEN:-}",
        "ZURP_ACCESS_TOKEN": "${ZURP_ACCESS_TOKEN:-}",
        "BB_RESEARCH_LOG_LEVEL": "${BB_RESEARCH_LOG_LEVEL:-warn}",
        "HTTPS_PROXY": "${HTTPS_PROXY:-}",
        "HTTP_PROXY": "${HTTP_PROXY:-}",
        "NO_PROXY": "${NO_PROXY:-}",
        "NODE_EXTRA_CA_CERTS": "${NODE_EXTRA_CA_CERTS:-}"
      }
    },
    "sparta": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/sparta/index.js"],
      "env": {
        "BB_RESEARCH_TOKEN": "${BB_RESEARCH_TOKEN:-}",
        "ZURP_ACCESS_TOKEN": "${ZURP_ACCESS_TOKEN:-}",
        "BB_RESEARCH_LOG_LEVEL": "${BB_RESEARCH_LOG_LEVEL:-warn}",
        "HTTPS_PROXY": "${HTTPS_PROXY:-}",
        "HTTP_PROXY": "${HTTP_PROXY:-}",
        "NO_PROXY": "${NO_PROXY:-}",
        "NODE_EXTRA_CA_CERTS": "${NODE_EXTRA_CA_CERTS:-}"
      }
    }
  }
}
